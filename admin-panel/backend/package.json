{
  "name": "brspark-admin-backend",
  "version": "1.0.0",
  "description": "BrSpark Admin Panel — PostgreSQL Backend API",
  "type": "commonjs",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "db:migrate": "bash scripts/db-migrate.sh",
    "db:backup": "bash scripts/backup.sh manual",
    "db:seed": "node src/seed.js",
    "db:studio": "npx prisma studio",
    "dropbox:check": "node scripts/check_dropbox.js",
    "dropbox:exchange": "node scripts/exchange_dbx.js",
    "dropbox:test-token": "node scripts/test_dbx.js",
    "db:reset": "echo '🚫 db:reset foi desabilitado para proteger dados. Use db:migrate para migrações seguras.'"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "prisma": "^5.10.0"
  }
}
