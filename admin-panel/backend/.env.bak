# Database — PostgreSQL de produção (direto na internet: 3.149.14.138:5432). Sem túnel SSH.
# Recomenda-se restringir no AWS Security Group o acesso TCP 5432 ao teu IP fixo.
DATABASE_URL="postgresql://brspark:b3760af6e90e7567fcceefe36a1e19d46688d0c7d09ece4bf9b4b6930edc85ce@3.149.14.138:5432/brspark_admin?schema=public"

# JWT
JWT_SECRET="brspark-admin-super-secret-jwt-key-2025-change-in-production"
JWT_EXPIRES_IN="8h"

# Bridge Laravel (BrsparkWeb) → tokens JWT para avaliações no painel web
BRSPARK_WEB_BRIDGE_SECRET=bd51782845d6ab0623a932145b3553b39015adde90cf3ac24fc0b9b4d1c34987

# Server
PORT=3001
NODE_ENV=development

# URL pública desta API (link iCal ocupação → Airbnb). Em produção use https://api.brspark.com (sem /api).
PUBLIC_API_BASE=http://localhost:3001

# BrSparkWeb (Laravel) — diretório do app (aba Serviços). Ajuste a porta se usar outro host.
CMS_DIRECTORY_BASE_URL=http://127.0.0.1:8000

# Admin seed credentials
ADMIN_EMAIL="admin@brspark.com"
ADMIN_PASSWORD="admin123"

# CORS — frontend origin
CORS_ORIGIN="http://localhost:3002"
