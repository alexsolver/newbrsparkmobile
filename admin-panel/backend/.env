# Database — PostgreSQL local (porta 5432). Para túnel SSH ver scripts/prod-postgres-tunnel.sh e ajustar a URL.
DATABASE_URL="postgresql://alex@localhost:5432/aria_admin?schema=public"

# JWT
JWT_SECRET="aria-admin-super-secret-jwt-key-2025-change-in-production"
JWT_EXPIRES_IN="8h"

# Bridge Laravel (AriaWeb) → tokens JWT para avaliações no painel web
ARIA_WEB_BRIDGE_SECRET=bd51782845d6ab0623a932145b3553b39015adde90cf3ac24fc0b9b4d1c34987

# Server
PORT=3001
NODE_ENV=development

# URL pública desta API (link iCal ocupação → Airbnb). Em produção use https://api.aria.com (sem /api).
PUBLIC_API_BASE=http://localhost:3001

# AriaWeb (Laravel) — diretório do app (aba Serviços). Ajuste a porta se usar outro host.
CMS_DIRECTORY_BASE_URL=http://127.0.0.1:8000

# Admin seed credentials
ADMIN_EMAIL="admin@aria.com"
ADMIN_PASSWORD="admin123"
# Mesma senha para admin@aria.com / gestor@aria.com no login com slug (reexecutar npm run db:seed após mudar).
SAAS_PANEL_PASSWORD="admin123"

# CORS — frontend origin
CORS_ORIGIN="http://localhost:3002"
