# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/brspark_admin?schema=public"

# JWT
JWT_SECRET="change-this-to-a-long-random-secret-in-production"
JWT_EXPIRES_IN="8h"

# Server
PORT=3001
NODE_ENV=development

# Diretório de prestadores (aba Serviços do app): BFF para o Laravel BrsparkWeb.
# Ex.: http://localhost:8000  ou  https://api.seudominio.com  (sem barra no fim)
# Se vazio, usa apenas ServiceProvider no PostgreSQL.
# CMS_DIRECTORY_BASE_URL="http://localhost:8000"

# Registo no app móvel — colocar novos utilizadores no tenant partilhado (consumidor / prestador individual).
# O seed cria slug "brspark-app". Sem isto, cada registo continua a criar um tenant próprio (modo legado).
# APP_DEFAULT_TENANT_SLUG="brspark-app"
# APP_DEFAULT_TENANT_ID=""

# Admin seed credentials (used in db:seed)
ADMIN_EMAIL="admin@brspark.com"
ADMIN_PASSWORD="admin123"

# CORS — frontend origin
CORS_ORIGIN="http://localhost:5500"

# URL pública da pasta do painel admin onde está evaluation-survey.html (sem barra no fim).
# Produção: defina sempre. Dev: se vazio, o backend usa o 1.º origin de CORS_ORIGIN acima.
# Ex.: https://admin.suaempresa.com  ou  https://app.suaempresa.com/brspark/admin-panel
# ADMIN_PANEL_PUBLIC_BASE_URL="https://admin.suaempresa.com"

# CompreFace — limiar mínimo de similaridade (0.5–0.999) para verify-face
# COMPREFACE_MIN_SIMILARITY=0.88

# Nylas API v3 — envio de e-mail (opcional; também pode configurar só no painel → Integrações)
# NYLAS_API_KEY=""        # API Key da aplicação (Bearer)
# NYLAS_API_URI="https://api.us.nylas.com"   # ou https://api.eu.nylas.com
# NYLAS_GRANT_ID=""       # ID do grant da conta de e-mail ligada via OAuth no dashboard Nylas (obrigatório para enviar)
