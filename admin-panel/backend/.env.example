# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/brspark_admin?schema=public"

# JWT
JWT_SECRET="change-this-to-a-long-random-secret-in-production"
JWT_EXPIRES_IN="8h"

# Bridge servidor Laravel (BrsparkWeb) → tokens para o módulo «Avaliações de desempenho» no CRM web.
# O mesmo valor deve existir como BRSPARK_WEB_BRIDGE_SECRET no .env do Laravel (e BRSPARK_NODE_URL deve apontar para esta API).
# BRSPARK_WEB_BRIDGE_SECRET="same-long-random-string-as-laravel"

# Server
PORT=3001
NODE_ENV=development

# URL pública desta API (sem /api no final) — link iCal de ocupação para Airbnb. Se vazio, usa o Host do pedido HTTP.
# PUBLIC_API_BASE="https://api.brspark.com"

# OBRIGATÓRIO para o app móvel listar empresas do CMS: BFF → Laravel BrsparkWeb.
# Sem CMS_DIRECTORY_BASE_URL, GET /api/providers devolve lista vazia (não há mais catálogo demo em PostgreSQL).
# Use a URL base da API Laravel (ex.: http://127.0.0.1:8000). Sem barra no final.
# CMS_DIRECTORY_BASE_URL="http://127.0.0.1:8000"
#
# Origem do Laravel **acessível pelo telefone** (imagem /storage no app). Se vazio, o app recebe a mesma URL que
# CMS_DIRECTORY_BASE_URL (127.0.0.1 só funciona no simulador na mesma máquina). Ex.: http://192.168.1.10:8000
# DIRECTORY_CMS_APP_ORIGIN="http://192.168.1.10:8000"
#
# O app carrega logos em `/storage/...` via GET público no Node: /api/directory-media?path=… (proxy ao Laravel).
# Não expõe token; só aceita caminhos que começam por /storage/.
# Token igual a BRSPARK_INTERNAL_API_TOKEN no Laravel — permite ao app (Perfil) gravar o banner do diretório.
# CMS_INTERNAL_API_TOKEN="gere-um-segredo-longo-aleatorio"
# Só para desenvolvimento legado: repor leitura de ServiceProvider no Node (lista extra face ao CMS).
# DIRECTORY_POSTGRES_FALLBACK=1

# Registro no app móvel — colocar novos usuários no tenant compartilhado (consumidor / prestador individual).
# O seed cria slug "brspark-app". Sem isto, cada registro continua a criar um tenant próprio (modo legado).
# APP_DEFAULT_TENANT_SLUG="brspark-app"
# APP_DEFAULT_TENANT_ID=""

# Admin seed credentials (used in db:seed) — tabela `Admin` do painel Node
ADMIN_EMAIL="admin@brspark.com"
ADMIN_PASSWORD="admin123"

# Senha dos utilizadores **User** do tenant org `brspark` (admin@, gestor@, alex@…) no seed. Não usa ADMIN_PASSWORD.
# Se vazio, o seed usa **123456** (demo do app).
# SAAS_PANEL_PASSWORD="123456"

# CORS — frontend origin
CORS_ORIGIN="http://localhost:5500"

# URL pública da pasta do painel admin (evaluation-survey.html, verify-email.html; sem barra no final).
# Produção: defina sempre. Dev: se vazio, usa http://127.0.0.1:<PORT> (mesma porta que este servidor — ver PORT acima), não CORS_ORIGIN.
# Ex.: https://admin.suaempresa.com  ou  https://app.suaempresa.com/brspark/admin-panel
# ADMIN_PANEL_PUBLIC_BASE_URL="https://admin.suaempresa.com"
#
# Usado nos e-mails de verificação de conta (verify-email.html), links absolutos do formulário de avaliação e convites «Enviar convite» no painel. Alias aceites: PUBLIC_PANEL_URL, ADMIN_PANEL_PUBLIC_URL.

# FaceMatch (motor facial) — limiar mínimo de similaridade (0.5–0.999) para verify-face
# COMPREFACE_MIN_SIMILARITY=0.88

# MailerSend — e-mails transacionais: verificação de conta (POST /api/users/:id/send-email-verification),
# convite de cadastro de prestador (technician registration) e convites de avaliação ao cliente (painel Qualidade).
# Se MAILERSEND_API_TOKEN e MAILERSEND_FROM_EMAIL estiverem definidos, o envio usa MailerSend; caso contrário tenta Nylas.
# O remetente deve ser de um domínio verificado no MailerSend.
# MAILERSEND_API_TOKEN=""
# MAILERSEND_FROM_EMAIL="noreply@seudominioverificado.com"
# MAILERSEND_FROM_NAME="BrSpark"
# Opcional — base da API (padrão https://api.mailersend.com/v1)
# MAILERSEND_API_BASE="https://api.mailersend.com/v1"

# Sincronização híbrida Node → Laravel (webhooks)
# URL base do Laravel, sem / no fim. CMS_INTERNAL_API_TOKEN = BRSPARK_INTERNAL_API_TOKEN.
# BRSPARK_LARAVEL_BASE_URL="http://127.0.0.1:8000"
# HMAC + Bearer (X-Brspark-Signature, X-Idempotency-Key) — alinhe com backend/.env BRSPARK_WEBHOOK_SECRET
# BRSPARK_WEBHOOK_SECRET="long-random-secret"

# OTP (Twilio) — início de sessão por SMS/WhatsApp/e-mail
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=+1234567890
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Em dev, para ver o código no resposta: ALLOW_OTP_PLAINTEXT=1
# E_SIGN_IFRAME_BASE_URL — URL de assinatura (ZapSign) embutida ou redirect
# E_SIGN_IFRAME_BASE_URL=
# E_SIGN_WEBHOOK_SECRET= — assinaturas (callback)
# S3 opcional: AWS_REGION, AWS_S3_BUCKET, AWS_S3_PUBLIC_BASE_URL (URLs públicas dos ficheiros)

# Nylas API v3 — envio de e-mail (opcional; também pode configurar só no painel → Integrações)
# NYLAS_API_KEY=""        # API Key da aplicação (Bearer)
# NYLAS_API_URI="https://api.us.nylas.com"   # ou https://api.eu.nylas.com
# NYLAS_GRANT_ID=""       # ID do grant da conta de e-mail ligada via OAuth no dashboard Nylas (obrigatório para enviar)
