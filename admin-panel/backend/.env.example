# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aria_admin?schema=public"
#
# Postgres em produção (EC2) costuma ouvir só 127.0.0.1: use túnel SSH e aponte DATABASE_URL à porta local.
# Raiz do repo: scripts/prod-postgres-tunnel.sh ou scripts/db-tunnel-production.sh
#   export ARIA_SSH_KEY="$HOME/Downloads/alex.pem" && ./scripts/prod-postgres-tunnel.sh
# Exemplo com túnel na porta 5433:
# DATABASE_URL="postgresql://USER:PASS@127.0.0.1:5433/aria_admin?schema=public&sslmode=disable"
#
# Prisma: piso mínimo de pool aplicado em código (src/db.js) se a URL tiver connection_limit/pool_timeout
# demasiado baixos — evita P2024 no login quando há tráfego paralelo com RLS (uma conexão por pedido até res.finish).
# Opcional: ARIA_PRISMA_CONNECTION_LIMIT_MIN=25  ARIA_PRISMA_POOL_TIMEOUT_SEC=60
#
# Row-Level Security (PostgreSQL): cada pedido autenticado corre dentro de uma transacção com set_config('app.*').
# Desactivar só em diagnóstico (não em produção com dados reais).
# ARIA_RLS_DISABLE=1
# Opcional: limites da transacção RLS (ms). O pedido HTTP fica ligado à transacção até `res.finish`.
# ARIA_RLS_TX_TIMEOUT_MS=300000
# ARIA_RLS_TX_MAXWAIT_MS=30000

# JWT
JWT_SECRET="change-this-to-a-long-random-secret-in-production"
# Painel admin (login /api/auth/*) — continua a usar JWT_EXPIRES_IN quando aplicável.
JWT_EXPIRES_IN="8h"
# App móvel (POST /api/login, etc.): JWT de acesso curto + refresh opaco em `app_refresh_sessions`.
# Se JWT_ACCESS_EXPIRES_IN estiver vazio, usa-se JWT_EXPIRES_IN e, em último caso, 24h.
JWT_ACCESS_EXPIRES_IN="24h"
# Duração do refresh (ex.: 90d). Aceita sufixo s|m|h|d como o jsonwebtoken.
JWT_REFRESH_EXPIRES_IN="90d"

# Bridge servidor Laravel (AriaWeb) → tokens para o módulo «Avaliações de desempenho» no CRM web.
# O mesmo valor deve existir como ARIA_WEB_BRIDGE_SECRET no .env do Laravel (e ARIA_NODE_URL deve apontar para esta API).
# Usado também em POST /api/internal/cms-tenant-provision e POST /api/internal/cms-operational-summary (header X-Bridge-Secret).
# ARIA_WEB_BRIDGE_SECRET="same-long-random-string-as-laravel"

# Server
PORT=3001
NODE_ENV=development

# URL pública desta API (sem /api no final) — link iCal de ocupação para Airbnb. Se vazio, usa o Host do pedido HTTP.
# PUBLIC_API_BASE="https://api.aria.com"
#
# Origem onde o browser (e o cliente no e-mail) abre track.html — mesmo host que serve /api/tracking.
# Se vazio, usa o Host do pedido (atenção: atrás de proxy pode sair http://10.x ou hostname interno).
# TRACKING_PUBLIC_BASE_URL="https://api.aria.com"

# OBRIGATÓRIO para o app móvel listar empresas do CMS: BFF → Laravel AriaWeb.
# Sem CMS_DIRECTORY_BASE_URL, GET /api/providers devolve lista vazia (não há mais catálogo demo em PostgreSQL).
# Use a URL base da API Laravel (ex.: http://127.0.0.1:8000). Sem barra no final.
# CMS_DIRECTORY_BASE_URL="http://127.0.0.1:8000"
#
# Origem do Laravel **acessível pelo telefone** (imagem /storage no app). Se vazio, o app recebe a mesma URL que
# CMS_DIRECTORY_BASE_URL (127.0.0.1 só funciona no simulador na mesma máquina). Ex.: http://192.168.1.10:8000
# DIRECTORY_CMS_APP_ORIGIN="http://192.168.1.10:8000"
#
# O app carrega logos em `/storage/...` via GET público no Node: /api/directory-media?path=… (proxy ao Laravel).
# Não expõe token; só aceita caminhos que começam por /storage/.
# Token igual a ARIA_INTERNAL_API_TOKEN no Laravel — permite ao app (Perfil) gravar o banner do diretório
# e ao Laravel gravar o espelho de branding (POST /api/internal/cms-branding-mirror). Alias opcional no Node: ARIA_INTERNAL_API_TOKEN.
# CMS_INTERNAL_API_TOKEN="gere-um-segredo-longo-aleatorio"
# Só para desenvolvimento legado: repor leitura de ServiceProvider no Node (lista extra face ao CMS).
# DIRECTORY_POSTGRES_FALLBACK=1

# Registo no app: tenant COMPANY partilhada onde são criados novos `User` (omissão: slug master; ver seed).
# APP_REGISTRATION_SHARED_TENANT_SLUG="master"
# APP_REGISTRATION_SHARED_TENANT_ID=""

# Login / contexto legado (OTP, admin): tenant master ou app por slug — distinto do registo partilhado acima.
# APP_DEFAULT_TENANT_SLUG="aria"
# APP_DEFAULT_TENANT_ID=""

# Admin seed credentials (used in db:seed) — tabela `Admin` do painel Node
ADMIN_EMAIL="admin@aria.com"
ADMIN_PASSWORD="admin123"

# Senha dos utilizadores **User** do tenant org `aria` (admin@, gestor@, alex@…) no seed. Não usa ADMIN_PASSWORD.
# Recomendado alinhar com ADMIN_PASSWORD para o login com slug aceitar a mesma senha que o admin legado.
# Se vazio, o seed usa **123456** (demo do app).
SAAS_PANEL_PASSWORD="admin123"

# CORS — frontend origin
CORS_ORIGIN="http://localhost:5500"

# URL pública da pasta do painel admin (evaluation-survey.html, verify-email.html; sem barra no final).
# Produção: defina sempre. Dev: se vazio, usa http://127.0.0.1:<PORT> (mesma porta que este servidor — ver PORT acima), não CORS_ORIGIN.
# Ex.: https://admin.suaempresa.com  ou  https://app.suaempresa.com/aria/admin-panel
# ADMIN_PANEL_PUBLIC_BASE_URL="https://admin.suaempresa.com"
#
# Usado nos e-mails de verificação de conta (verify-email.html), links absolutos do formulário de avaliação e convites «Enviar convite» no painel. Alias aceites: PUBLIC_PANEL_URL, ADMIN_PANEL_PUBLIC_URL.

# FaceMatch (motor facial) — limiar mínimo de similaridade (0.5–0.999) para verify-face
# COMPREFACE_MIN_SIMILARITY=0.88
# Só modo «buscar» (identify): limiar opcional (por omissão = COMPREFACE_MIN_SIMILARITY). Ex.: 0.82 se a galeria devolver scores logo abaixo do global.
# COMPREFACE_IDENTIFY_MIN_SIMILARITY=
# self_verify: por defeito usa Verification 1:1 (requer comprefaceVerificationKey na integração). `1` força só Recognition.
# COMPREFACE_SELF_VERIFY_USE_RECOGNITION_ONLY=1
# Verification: timeout por pedido HTTP (ms). Padrão 60000; mín. 15000; máx. 120000.
# COMPREFACE_VERIFICATION_TIMEOUT_MS=60000
# `1` = só uma direção probe→ref por par (mais rápido; menos conservador que min das duas direções).
# COMPREFACE_VERIFICATION_SINGLE_DIRECTION=0
# Quantas fotos de referência do utilizador comparar em paralelo no self_verify 1:1 (1–4). Padrão 1 (sequencial); `2` ou mais acelera se a referência certa não for a 1.ª (mais carga no FaceMatch).
# COMPREFACE_VERIFICATION_REF_CONCURRENCY=1

# MailerSend — fallback para e-mail transacional quando **Microsoft Graph** não está configurado.
# (Verificação de conta, convites prestador/avaliações, redefinição de senha, etc.)
# Se MAILERSEND_API_TOKEN e MAILERSEND_FROM_EMAIL estiverem definidos, o envio usa MailerSend; caso contrário tenta Nylas.
# O remetente deve ser de um domínio verificado no MailerSend.
# MAILERSEND_API_TOKEN=""
# MAILERSEND_FROM_EMAIL="noreply@seudominioverificado.com"
# MAILERSEND_FROM_NAME="Aria"
# Opcional — base da API (padrão https://api.mailersend.com/v1)
# MAILERSEND_API_BASE="https://api.mailersend.com/v1"

# ─── App Store / logos em `/storage/…` (GET /api/me) ─────────────────────────
# O CMS grava logos como caminho `/storage/tenant-branding/...`. O app junta isso ao host errado se a URL
# for relativa. Em PRODUÇÃO defina UMA destas (origem pública HTTPS do Laravel, sem barra no fim):
#   ARIA_CMS_PUBLIC_URL   (preferido)  ou  LARAVEL_APP_URL  ou  reuse ARIA_LARAVEL_BASE_URL / CMS_DIRECTORY_BASE_URL
# Ex.: ARIA_CMS_PUBLIC_URL="https://app.aria.com"
# Depois: reiniciar a API Node (pm2 restart …).
# ARIA_CMS_PUBLIC_URL=""

# Sincronização híbrida Node → Laravel (webhooks)
# URL base do Laravel, sem / no fim. CMS_INTERNAL_API_TOKEN = ARIA_INTERNAL_API_TOKEN.
# ARIA_LARAVEL_BASE_URL="http://127.0.0.1:8000"
# HMAC + Bearer (X-Aria-Signature, X-Idempotency-Key) — alinhe com backend/.env ARIA_WEBHOOK_SECRET
# ARIA_WEBHOOK_SECRET="long-random-secret"

# Microsoft Graph (daemon) — **primeiro** canal para todo o e-mail transacional (OTP, reset de senha, convites, …)
# quando a integração «Microsoft Graph» no painel (ou estas vars) estiver completa.
# MICROSOFT_GRAPH_TENANT_ID=""
# MICROSOFT_GRAPH_CLIENT_ID=""
# MICROSOFT_GRAPH_CLIENT_SECRET=""
# MICROSOFT_GRAPH_SEND_AS_USER="noreply@empresa.onmicrosoft.com"
# MICROSOFT_GRAPH_FROM_NAME="Aria"
# MICROSOFT_GRAPH_API_BASE="https://graph.microsoft.com/v1.0"

# OTP — início de sessão por e-mail. Se Microsoft Graph estiver configurado, **só** Graph para OTP.
# Caso contrário: OTP_EMAIL_PROVIDER — Nylas primeiro (omissão) ou MailerSend primeiro.
# OTP_EMAIL_PROVIDER=nylas   # omissão: Nylas → MailerSend
# OTP_EMAIL_PROVIDER=mailersend   # inverso
# OTP_EMAIL_PROVIDER=legacy   # igual aos outros e-mails (Graph → MailerSend → Nylas)
# Em dev, código por telefone no log: ALLOW_OTP_PLAINTEXT=1
# E_SIGN_IFRAME_BASE_URL — URL de assinatura (ZapSign) embutida ou redirect
# E_SIGN_IFRAME_BASE_URL=
# E_SIGN_WEBHOOK_SECRET= — assinaturas (callback)
# S3 opcional: AWS_REGION, AWS_S3_BUCKET, AWS_S3_PUBLIC_BASE_URL (URLs públicas dos ficheiros)

# Nylas API v3 — envio de e-mail (opcional; também pode configurar só no painel → Integrações)
# NYLAS_API_KEY=""        # API Key da aplicação (Bearer)
# NYLAS_API_URI="https://api.us.nylas.com"   # ou https://api.eu.nylas.com
# NYLAS_GRANT_ID=""       # ID do grant da conta de e-mail ligada via OAuth no dashboard Nylas (obrigatório para enviar)

# Cadastro prestador (app): após POST …/submit bem-sucedido, o backend chama sempre materializeApprovedApplication
# (perfil ACTIVE na mesma requisição). Não há fila de aprovação manual por variável de ambiente.
# (Legado ignorado: TECH_REG_SKIP_AUTO_APPROVE_AFTER_SUBMIT.)

# Dropbox — scripts: npm run dropbox:oauth-local | dropbox:exchange | dropbox:test-token
# No app Dropbox → OAuth 2 → Redirect URIs: http://127.0.0.1:8765/dropbox-oauth-callback (ou DROPBOX_REDIRECT_URI abaixo)
# DROPBOX_APP_KEY=""
# DROPBOX_APP_SECRET=""
# DROPBOX_OAUTH_PORT=8765
# DROPBOX_REDIRECT_URI="http://127.0.0.1:8765/dropbox-oauth-callback"
# Troca pontual por código: DROPBOX_OAUTH_CODE="..."
