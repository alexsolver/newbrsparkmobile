// BrSpark Admin — Prisma Schema (PostgreSQL)
// Run: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────
// ADMINS (painel interno)
// ─────────────────────────────────────────────────────────
model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String   // bcrypt hash
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  auditLogs AuditLog[]
}

// ─────────────────────────────────────────────────────────
// PLANOS
// ─────────────────────────────────────────────────────────
model Plan {
  id            String   @id @default(cuid())
  name          String   @unique  // Basic | Pro | Enterprise
  priceMonthly  Decimal  @db.Decimal(10,2)
  priceYearly   Decimal  @db.Decimal(10,2)
  maxAssets     Int      // -1 = unlimited
  maxUsers      Int      // -1 = unlimited
  storageGb     Int
  features      Json     // { stock, vault, ai, facialVisionProvider: COMPREFACE|AUTO|AWS, ... }
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  subscriptions Subscription[]
}

// ─────────────────────────────────────────────────────────
// TENANTS
// ─────────────────────────────────────────────────────────
model Tenant {
  id           String   @id @default(cuid())
  name         String                        // nome completo do usuário
  slug         String   @unique              // gerado do email
  email        String   @unique              // email do dono da conta (= login)
  ownerName    String                        // nome de exibição
  phone        String?
  taxId        String?                       // CPF
  avatarUrl    String?
  defaultLang  String   @default("pt-BR")
  localeId     String?
  locale       LocaleProfile? @relation(fields: [localeId], references: [id])
  status       TenantStatus @default(TRIAL)
  sectorCode   String?                       // telecom | utilities | saude | predial | outro
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscription         Subscription?
  users                User[]
  assets               Asset[]
  locations            Location[]
  auditLogs            AuditLog[]
  featureFlags         FeatureFlag[]
  translationOverrides TranslationOverride[]
  collectionPolicies   CollectionPolicy[]
  complianceDocs       ComplianceDoc[]       @relation("TenantComplianceDocs")
  materialsReceiptInputs MaterialsReceiptInput[]
  evaluationTemplates   EvaluationTemplate[]
  evaluationInstances   EvaluationInstance[]
  evaluationActionPlans EvaluationActionPlan[]
  evaluationDisputes    EvaluationDispute[]
  technicianRegistrationApplications TechnicianRegistrationApplication[]
}

/// Candidatura de cadastro de prestador (formulário global + revisão do gestor).
model TechnicianRegistrationApplication {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Token secreto na URL de convite (único).
  inviteToken    String   @unique
  invitedEmail   String
  status         String   @default("INVITED")
  /// Última mensagem do gestor ao pedir ajustes (visível ao candidato).
  revisionNote   String?
  /// Payload alinhado ao formulário admin (dados pessoais, endereço, docs, horários, regiões, fotos base…).
  responsesJson  Json     @default("{}")
  /// Senha definida pelo candidato na submissão (bcrypt); removida após aprovação.
  passwordHash   String?
  /// Utilizador criado após aprovação (1:1).
  createdUserId  String?  @unique
  createdUser    User?    @relation("TechRegCreatedUser", fields: [createdUserId], references: [id], onDelete: SetNull)
  /// Quem criou o convite (painel).
  createdByUserId String?
  /// Utilizador da app que iniciou sessão para preencher (mesmo e-mail do convite).
  candidateUserId String?
  candidateUser   User?    @relation("TechRegCandidateUser", fields: [candidateUserId], references: [id], onDelete: SetNull)
  submittedAt    DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  events         TechnicianRegistrationEvent[]

  @@index([tenantId, status])
  @@index([invitedEmail, tenantId])
}

model TechnicianRegistrationEvent {
  id              String   @id @default(cuid())
  applicationId   String
  application     TechnicianRegistrationApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type            String
  message         String?
  actorEmail      String?
  createdAt       DateTime @default(now())

  @@index([applicationId, createdAt])
}

// ─────────────────────────────────────────────────────────
// SOBREPOSIÇÃO DE TRADUÇÃO (TENANT OVERRIDES)
// ─────────────────────────────────────────────────────────
model TranslationOverride {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  key       String   // i18n key como "common.save" ou "metatag.AssetStatus"
  language  String   // pt-BR, en-US, es-ES
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key, language])
}

// ─────────────────────────────────────────────────────────
// CONFIGURAÇÕES GLOBAIS / LOCALIZAÇÃO
// ─────────────────────────────────────────────────────────
model LocaleProfile {
  id              String   @id @default(cuid())
  countryCode     String   @unique // BR, US, ES, AR, CL...
  name            String   // Brasil, United States, España
  language        String   @default("pt-BR")
  currency        String   @default("BRL")
  currencySymbol  String   @default("R$")
  dateFormat      String   @default("DD/MM/YYYY")
  numberFormat    String   @default("PT_STYLE") // PT_STYLE (1.000,00) or US_STYLE (1,000.00)
  timezone        String   @default("UTC")
  taxIdLabel      String   @default("Tax ID") // CPF, SSN, NIF, RUT
  postalCodeLabel String   @default("Postal Code") // CEP, ZIP, CP
  measureSystem   String   @default("METRIC") // METRIC, IMPERIAL
  isActive        Boolean  @default(true)
  tenants         Tenant[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

// ─────────────────────────────────────────────────────────
// ASSINATURAS
// ─────────────────────────────────────────────────────────
model Subscription {
  id            String   @id @default(cuid())
  tenantId      String   @unique
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  planId        String
  plan          Plan     @relation(fields: [planId], references: [id])
  billingCycle  BillingCycle @default(MONTHLY)
  status        SubStatus    @default(ACTIVE)
  currentStart  DateTime
  currentEnd    DateTime
  cancelledAt   DateTime?
  trialEndsAt   DateTime?
  externalId    String?  // Stripe subscription ID
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  invoices      Invoice[]
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIALING
}

// ─────────────────────────────────────────────────────────
// FATURAS
// ─────────────────────────────────────────────────────────
model Invoice {
  id             String   @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  amount         Decimal  @db.Decimal(10,2)
  status         InvoiceStatus @default(PENDING)
  dueDate        DateTime
  paidAt         DateTime?
  externalId     String?  // Stripe invoice ID
  createdAt      DateTime @default(now())
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  VOID
}

// ─────────────────────────────────────────────────────────
// USUÁRIOS
// ─────────────────────────────────────────────────────────
model User {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  email      String
  name       String
  password   String   // bcrypt hash
  avatarUrl  String?
  phone      String?
  /// Endereço residencial / correspondência (JSON estruturado, alinhado a multi-location)
  addressJson       Json?
  /// Documentos pessoais: [{ id, docType, label, identifier, validFrom, validTo, issuingBody, notes, locationIds[] }]
  personalDocuments Json?
  /// Fotos base para reconhecimento facial (admin): [{ id, url, mimeType?, createdAt }]
  faceEnrollmentPhotos Json?
  /// Último estado da galeria Recognition CompreFace: { status, at, faces?, subject?, message?, previous? }
  comprefaceRecognitionSync Json?
  role       UserRole @default(USER)
  /// BCP-47 (ex.: pt-BR, en-US, es-ES) para tradução automática no chat; null = usar idioma do dispositivo / tenant.
  preferredChatLocale String? @map("preferred_chat_locale")
  isActive   Boolean  @default(true)
  lastLogin  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  auditLogs  AuditLog[]
  pushTokens PushToken[]
  technicianProfile TechnicianProfile?
  /// Preenchido se o utilizador foi criado por uma candidatura de prestador aprovada.
  techRegistrationCreatedFrom TechnicianRegistrationApplication? @relation("TechRegCreatedUser")
  technicianRegistrationCandidacies TechnicianRegistrationApplication[] @relation("TechRegCandidateUser")
  currentSessionId String?
  currentDeviceId  String?
  materialsReceiptInputs MaterialsReceiptInput[] @relation("MaterialsReceiptConductor")
  evaluationInstancesAsTechnician EvaluationInstance[] @relation("EvaluationInstanceTechnician")
  evaluationAcknowledgements      EvaluationAcknowledgement[]
  evaluationInternalNotes         EvaluationInternalNote[]
  evaluationActionPlans           EvaluationActionPlan[] @relation("ActionPlanTechnician")
  disputesOpened                  EvaluationDispute[] @relation("DisputeOpenedByTechnician")
  disputesResolved                EvaluationDispute[] @relation("DisputeResolvedBySupervisor")

  @@unique([email, tenantId])
}

model TechnicianProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String   @default("PENDING") // PENDING, ACTIVE, INACTIVE, SUSPENDED
  score     Float    @default(5.0)
  cft       String?  // Conselho Federal dos Técnicos
  specialty String?
  /// Horários: { mon: [{ id, enabled, start, end, locationIds[] }], ... } — vários turnos/dia; legado: mon: { enabled, start, end }
  workScheduleJson Json?
  /// Lista de competências / tags
  skillsJson       Json?
  /// IDs de Location (tenant) onde o prestador atende — multi-location
  serviceLocationIds Json?
  /// Documentos profissionais (certificações, ASO, etc.) com locationIds[] por linha
  professionalDocuments Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  USER
  PROVIDER
  MANAGER
  TENANT_ADMIN
  SAAS_ADMIN
}

// ─────────────────────────────────────────────────────────
// BENS / ATIVOS
// ─────────────────────────────────────────────────────────
model Asset {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  parentId    String?  // hierarchical tree
  title       String
  type        AssetType
  status      String   @default("Operacional")
  description String?
  imageUrl    String?
  locationId  String?
  location    Location? @relation(fields: [locationId], references: [id])
  metadata    Json?    // custom fields (details, photos, etc.)
  deletedAt   DateTime? // soft delete para sync mobile
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  children    Asset[]  @relation("AssetHierarchy")
  parent      Asset?   @relation("AssetHierarchy", fields: [parentId], references: [id])
  stockItems  StockItem[]
}

enum AssetType {
  REAL_ESTATE
  TERRESTRIAL
  AQUATIC
  SPECIAL
  OTHER
}

// ─────────────────────────────────────────────────────────
// MULTI-LOCATION
// ─────────────────────────────────────────────────────────
model Location {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  name       String
  type       LocationType @default(BUILDING)
  address    String?
  floor      String?
  room       String?
  icon       String?
  latitude   Float?
  longitude  Float?
  parentId   String?
  parent     Location? @relation("LocationHierarchy", fields: [parentId], references: [id])
  children   Location[] @relation("LocationHierarchy")
  assets     Asset[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum LocationType {
  BUILDING
  FLOOR
  ROOM
  AREA
  WAREHOUSE
  OTHER
}

// ─────────────────────────────────────────────────────────
// ESTOQUE
// ─────────────────────────────────────────────────────────
model StockItem {
  id           String   @id @default(cuid())
  assetId      String
  asset        Asset    @relation(fields: [assetId], references: [id])
  name         String
  sku          String
  currentStock Int      @default(0)
  minStock     Int      @default(1)
  unit         String   @default("un")
  subLocation  String?
  unitPrice    Decimal? @db.Decimal(10,2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  movements    StockMovement[]

  @@unique([assetId, sku])
}

model StockMovement {
  id          String   @id @default(cuid())
  itemId      String
  item        StockItem @relation(fields: [itemId], references: [id])
  type        MovementType
  quantity    Int
  reason      String?
  fromAssetId String?
  toAssetId   String?
  createdAt   DateTime @default(now())
}

enum MovementType {
  IN
  OUT
  TRANSFER
}

// ─────────────────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────────────────
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  adminId    String?
  admin      Admin?   @relation(fields: [adminId], references: [id])
  action     String   // e.g. TENANT_CREATE, ASSET_UPDATE, LOGIN
  resource   String   // what was affected
  category   AuditCategory
  metadata   Json?    // extra context
  ipAddress  String?
  createdAt  DateTime @default(now())
}

enum AuditCategory {
  AUTH
  DATA
  ADMIN
  SYSTEM
}

// ─────────────────────────────────────────────────────────
// FEATURE FLAGS
// ─────────────────────────────────────────────────────────
model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   // e.g. "stock", "vault", "ai"
  label       String
  description String
  icon        String?
  enabled     Boolean  @default(true)
  tenantId    String?  // null = global default
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  updatedAt   DateTime @updatedAt

  @@unique([key, tenantId])
}

// ─────────────────────────────────────────────────────────
// METATAGS
// ─────────────────────────────────────────────────────────
model Metatag {
  id         String      @id @default(cuid())
  type       MetatagType
  key        String      @unique
  ptBr       String
  enUs       String
  esEs       String
  icon       String?
  color      String?
  isActive   Boolean     @default(true)
  sortOrder  Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

enum MetatagType {
  ASSET_TYPE
  STOCK_CATEGORY
  SERVICE_CATEGORY
  EXPENSE_CATEGORY
  REVENUE_CATEGORY
  TECHNICIAN_EXPENSE_CATEGORY
  ASSET_STATUS
  MEDIA_CATEGORY
  GLOBAL_TAG
}

// ─────────────────────────────────────────────────────────
// INTEGRAÇÕES
// ─────────────────────────────────────────────────────────
model Integration {
  id                        String   @id @default(cuid())
  name                      String
  type                      IntType
  description               String?
  icon                      String?
  apiKey                    String?  // encrypted in production — CompreFace: Recognition
  comprefaceDetectionKey    String?
  comprefaceVerificationKey String?
  baseUrl                   String?
  webhookUrl                String?
  status                    String   @default("ACTIVE")  // ACTIVE | ERROR | DISCONNECTED
  lastTestedAt              DateTime?
  metadata                  Json?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

enum IntType {
  AI_LLM
  EMAIL
  PUSH
  STORAGE
  WEBHOOK
  ERP
  PAYMENT
  MAPS
}

// ─────────────────────────────────────────────────────────
// COMPLIANCE / LGPD
// ─────────────────────────────────────────────────────────
model ComplianceDoc {
  id          String   @id @default(cuid())
  type        DocType
  version     String   // e.g. "1.2"
  title       String
  content     String   @db.Text
  isActive    Boolean  @default(false)  // only one active per type
  publishedAt DateTime?
  createdBy   String?  // admin email
  tenantId    String?  // null = global default
  tenant      Tenant?  @relation("TenantComplianceDocs", fields: [tenantId], references: [id])
  sectorCode  String?  // telecom | utilities | saude | predial | outro
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  acceptances ComplianceAcceptance[]
  consentRecords ConsentRecord[]
}

enum DocType {
  TERMS_OF_USE
  PRIVACY_POLICY
  LGPD_DPA
  COOKIE_POLICY
}

model ComplianceAcceptance {
  id        String   @id @default(cuid())
  docId     String
  doc       ComplianceDoc @relation(fields: [docId], references: [id])
  userId    String?
  tenantId  String?
  ipAddress String?
  acceptedAt DateTime @default(now())
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  device    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────
// SHARING & COLLABORATION
// ─────────────────────────────────────────────────────────
model AssetShare {
  id              String   @id @default(cuid())
  assetId         String   // O Bem compartilhado
  ownerEmail      String   // Quem convidou
  sharedWithEmail String   // O convidado
  permission      String   // "READ" | "WRITE"
  modules         Json     // Ex: ["costs", "docs", "maint"] ou ["all"]
  status          String   @default("PENDING") // PENDING, ACCEPTED
  expiresAt       DateTime? // Validade do compartilhamento
  invitedAt       DateTime @default(now())

  @@unique([assetId, sharedWithEmail])
}

// ─────────────────────────────────────────────────────────
// NOTIFICAÇÕES
// ─────────────────────────────────────────────────────────
model NotificationTemplate {
  id        String   @id @default(cuid())
  key       String   @unique  // e.g. "welcome", "stock_low"
  label     String
  channel   Channel
  subject   String?  // for email
  body      String   @db.Text
  variables Json?    // list of available {{vars}}
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  logs      NotificationLog[]
}

model NotificationLog {
  id         String   @id @default(cuid())
  templateId String
  template   NotificationTemplate @relation(fields: [templateId], references: [id])
  recipient  String
  channel    Channel
  status     NotifStatus @default(SENT)
  sentAt     DateTime @default(now())
  metadata   Json?
}

enum Channel {
  EMAIL
  PUSH
  WHATSAPP
  SMS
}

enum NotifStatus {
  SENT
  DELIVERED
  FAILED
  BOUNCED
}

// ─────────────────────────────────────────────────────────
// PRESTADORES DE SERVIÇO (catálogo global)
// ─────────────────────────────────────────────────────────
model ServiceProvider {
  id        String   @id @default(cuid())
  name      String
  category  String   // ex: "Elétrica", "Hidráulica", "Limpeza"
  rating    Float    @default(0)
  reviews   Int      @default(0)
  photo     String?  // URL da foto/avatar
  tags      Json?    // ["rápido", "confiável"]
  keywords  String?  // busca full-text
  phone     String?
  email     String?
  city      String?
  state     String   @default("SP")
  verified  Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
// ─────────────────────────────────────────────────────────
// DADOS DE MÓDULOS DO APP MOBILE (sync offline-first)
// Armazena JSON de cada módulo por ownerEmail, sem schema fixo.
// ─────────────────────────────────────────────────────────
model UserModuleData {
  id         String   @id @default(cuid())
  ownerEmail String
  module     String   // costs_expenses | costs_recurring | costs_budgets | insurance_policies | vault | media | maintenances | asset_docs | stock_items | stock_movements
  data       Json     // array de registros
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@unique([ownerEmail, module])
  @@index([ownerEmail])
}

// ─────────────────────────────────────────────────────────
// CHAT E MENSAGERIA CORPORATIVA
// ─────────────────────────────────────────────────────────
model ChatContact {
  id          String   @id @default(cuid())
  requesterId String   // Email do solicitante
  addresseeId String   // Email do destinatário
  status      String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([requesterId, addresseeId])
}

model ChatRoom {
  id          String   @id @default(cuid())
  name        String?
  description String?
  avatarColor String?  @default("#2563EB")
  isGroup     Boolean  @default(false)
  creatorId   String?  // Email do dono/admin do grupo
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     ChatRoomMember[]
  messages    ChatMessage[]
}

model ChatRoomMember {
  id        String   @id @default(cuid())
  roomId    String
  userId    String   // Email
  role      String   @default("MEMBER") // ADMIN, MEMBER
  joinedAt  DateTime @default(now())
  lastReadAt DateTime @default(now())
  room      ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
}

model ChatMessage {
  id         String   @id @default(cuid())
  roomId     String
  senderId   String   // Email
  senderName String
  type       String   @default("text") // text, audio, video, image
  content    String?  @db.Text
  mediaUrl   String?
  /// Cache de traduções por locale canónico: { "pt-BR": "…", "en-US": "…" }
  translations Json?   @map("translations")
  createdAt  DateTime @default(now())
  
  room       ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────
// CHECKLISTS FSM E WORKFORCE MANAGEMENT
// ─────────────────────────────────────────────────────────
// Pastas do Form Builder (apenas admin — organização de modelos)
model ChecklistTemplateFolder {
  id        String   @id @default(cuid())
  parentId  String?
  parent    ChecklistTemplateFolder?  @relation("ChecklistTemplateFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  ChecklistTemplateFolder[] @relation("ChecklistTemplateFolderTree")
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  templates ChecklistTemplate[]
}

model ChecklistTemplate {
  id          String   @id @default(cuid())
  tenantId    String?  
  title       String
  description String?
  settings    Json     // Ex: { requireGlobalGeofence: true, globalGeofenceRadius: 200 }
  schemaData  Json     // O Array das perguntas do Drag&Drop
  metadata    Json?    // Ex: { icon: "cart", iconLibrary: "Ionicons", iconColor: "#000" }
  version     Int      @default(1)
  isActive    Boolean  @default(true)
  folderId    String?
  folder      ChecklistTemplateFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  executions  ChecklistExecution[]
}

/// Contador global por período AAAA-MM (fuso America/Sao_Paulo) para FT-AAAA-MM-NNNNNNN.
model OsSerialCounter {
  periodKey String @id
  lastSeq   Int    @default(0)
}

/// Pré-carga de linhas para o campo «materiais / entrada» (integrações ERP → técnico).
/// Colunas físicas em snake_case na tabela `materials_receipt_inputs`.
model MaterialsReceiptInput {
  id             String   @id @default(cuid())
  conductorId    String   @map("conductor_id")
  tenantId       String   @map("tenant_id")
  nome           String
  codigoInterno  String   @default("") @map("codigo_interno")
  sku            String   @default("")
  precoUn        Decimal? @map("preco_un") @db.Decimal(14, 4)
  qtd            Int      @default(0)
  meta           Json?    @map("meta") @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conductor User   @relation("MaterialsReceiptConductor", fields: [conductorId], references: [id], onDelete: Cascade)

  @@index([tenantId, conductorId])
  @@map("materials_receipt_inputs")
}

model ChecklistExecution {
  id          String   @id @default(cuid())
  /// Número convencional ex.: FT-2026-04-0000001. Único entre valores não nulos (índice parcial SQL; ver migration).
  osNumber    String?
  templateId  String?
  template    ChecklistTemplate? @relation(fields: [templateId], references: [id])
  ownerEmail  String   // Email do Técnico/Coordenador
  assetId     String?  // Equipamento em Manutenção
  status      String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, SYNCED
  responses   Json?    // Respostas nativas das perguntas (null enquanto PENDING)
  metadata    Json?    // Metadata do smartphone
  /// Snapshot derivado (deslocamento, % vs previsto, produtividade) — alinhado ao PDF; atualizado a cada submissão concluída
  businessMetrics Json?
  /// Última revisão concluída e sincronizada (0 = nunca; próximo submit = +1)
  lastSubmittedRevision Int @default(0)

  revisions ChecklistExecutionRevision[]

  // Localização do Local de Serviço (Geofencing)
  locationAddress  String?  // Endereço legível pelo gestor
  locationLat      Float?   // Latitude do ponto de destino (para radius)
  locationLng      Float?   // Longitude do ponto de destino (para radius)
  locationRadius   Int?     // Raio de aceitação em metros
  locationZoneType String?  // 'radius' | 'polygon' | 'route'
  locationPolygon  Json?    // [[lat,lng],...] — polígono de área ou pontos do trajeto
  etaMinutes       Int?     // Tempo estimado de chegada atualizado via telemetria

  /// Início do bloco na agenda do técnico (planejado no despacho).
  scheduledStartAt DateTime? @map("scheduled_start_at")
  /// Snapshot: minutos previstos para preencher o formulário (sem deslocamento); múltiplos de 5; imutável após despacho.
  expectedFormDurationMinutes Int? @map("expected_form_duration_minutes")

  // Auditoria (Provas WFM)
  gpsLocation Json?    // {lat, lng, radius} coletado ao concluir
  startedAt   DateTime?
  completedAt DateTime?
  syncedAt    DateTime?
  createdAt   DateTime @default(now())

  evaluationInstances EvaluationInstance[]

  @@index([ownerEmail])
  @@index([status])
  @@index([ownerEmail, status])
}

/// Snapshot imutável por conclusão (revisita = nova linha; FT/osNumber estáveis na execução).
model ChecklistExecutionRevision {
  id               String   @id @default(cuid())
  executionId      String
  execution        ChecklistExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  revision         Int
  responses        Json
  metadataSnapshot Json?
  /// Métricas derivadas congeladas para esta revisão (igual à lógica do PDF na data da submissão)
  businessMetrics  Json?
  completedAt      DateTime?
  /// Idempotência CRM / retries do outbox (único quando preenchido)
  submissionId     String?  @unique
  createdAt        DateTime @default(now())

  @@unique([executionId, revision])
  @@index([executionId])
}

/// Preset de layout para relatório PDF (painel) e export JSON por API — escolha manual do gestor/integração.
model PdfReportPreset {
  id        String   @id @default(cuid())
  tenantId  String?  // null = presets globais do admin
  name      String
  slug      String?
  config    Json     // módulos, logoUrl, hideEmptyFields, fields.{id}.visible, etc.
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────
// COLETA DE DADOS — DATA COLLECTION FOUNDATION
// ─────────────────────────────────────────────────────────

// Política de coleta: global (tenantId null) ou override por tenant
model CollectionPolicy {
  id          String   @id @default(cuid())
  tenantId    String?  // null = política global padrão
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  sectorCode  String?  // telecom | utilities | saude | predial | outro
  label       String   @default("Padrão")

  // ── Localização ──────────────────────────────────────
  locationEnabled               Boolean @default(true)
  locationBackgroundEnabled     Boolean @default(true)
  locationIntervalIdleMin       Int     @default(30)
  locationIntervalTransitMin    Int     @default(2)
  /// IN_TRANSIT: intervalo mínimo entre leituras (seg). Se null, usa locationIntervalTransitMin × 60.
  locationIntervalTransitSec    Int?
  locationIntervalOnSiteMin     Int     @default(5)
  locationDistanceFilterMeters  Int     @default(200)

  // ── Retenção ─────────────────────────────────────────
  retentionGpsRawDays     Int @default(15)
  retentionEventsYears    Int @default(5)
  retentionAuditDays      Int @default(180)
  retentionMetricsDays    Int @default(730)

  // ── Integridade / Antifraude ──────────────────────────
  mockGpsAction          String @default("WARN")   // BLOCK | WARN | LOG
  rootJailbreakAction    String @default("WARN")   // BLOCK | WARN | LOG
  clockDriftMaxSeconds   Int    @default(300)

  // ── Consentimento ────────────────────────────────────
  requireExplicitConsent Boolean @default(true)
  consentGranular        Boolean @default(true)
  legalBasis             String  @default("LGPD")  // LGPD | GDPR | CCPA | OTHER

  // ── Comportamento de checkin ──────────────────────────
  requireCheckinPhoto  Boolean @default(false)
  allowOfflineCheckin  Boolean @default(true)
  minOnSiteMinutes     Int     @default(0)

  // ── Comportamento fora da política ───────────────────
  outOfPolicyAction  String @default("PROCEED_FLAG") // PROCEED_FLAG | BLOCK | WARN

  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  consentRecords ConsentRecord[]

  @@unique([tenantId, sectorCode])
  @@index([tenantId])
}

// Registro granular de eventos de telemetria (event store)
model TelemetryEvent {
  id            String   @id @default(cuid())
  tenantId      String?
  ownerEmail    String
  deviceId      String?  // pseudonimizado: hash do device
  executionId   String?  // FK ChecklistExecution (sem constraint — suporta offline)

  // ── Tipo do evento ────────────────────────────────────
  eventType     TelemetryEventType

  // ── Localização ──────────────────────────────────────
  lat           Float?
  lng           Float?
  accuracy      Float?
  altitude      Float?
  speed         Float?
  heading       Float?
  locationSource String? // GPS | NETWORK | HYBRID

  // ── Dispositivo ───────────────────────────────────────
  batteryLevel    Float?  // 0.0 a 1.0
  batteryCharging Boolean?
  networkType     String? // WIFI | 4G | 5G | OFFLINE
  appVersion      String?
  osVersion       String?
  deviceModel     String?

  // ── Integridade ───────────────────────────────────────
  isMockLocation  Boolean @default(false)
  isRooted        Boolean @default(false)
  clockDriftMs    Int?    // diferença entre relógio do app e servidor

  // ── Timestamps ────────────────────────────────────────
  serverTimestamp DateTime @default(now())
  deviceTimestamp DateTime?

  // ── Dados extras por tipo de evento ──────────────────
  payload Json?

  // ── Retenção ─────────────────────────────────────────
  retentionTier String   @default("OPERATIONAL") // RAW_SHORT | OPERATIONAL | LEGAL | PERMANENT
  expiresAt     DateTime?

  @@index([tenantId, eventType, serverTimestamp])
  @@index([ownerEmail, serverTimestamp])
  @@index([executionId])
  @@index([expiresAt])
}

enum TelemetryEventType {
  SESSION_OPEN
  SESSION_CLOSE
  OS_ACCEPT
  OS_START
  CHECKIN
  CHECKOUT
  TRANSIT_START
  TRANSIT_END
  HEARTBEAT
  GEOFENCE_ENTER
  GEOFENCE_EXIT
  PAUSE
  RESUME
  FRAUD_FLAG
  INTEGRITY_CHECK
  POLICY_VIOLATION
}

// Métricas calculadas por execução de OS
model ExecutionMetric {
  id           String   @id @default(cuid())
  tenantId     String?
  executionId  String   @unique  // FK ChecklistExecution
  ownerEmail   String

  // ── Tempos (minutos) ──────────────────────────────────
  etaMinutes          Int?
  transitDurationMin  Int?
  siteArrivalDelayMin   Int?  // positivo = atrasado, negativo = adiantado
  onSiteDurationMin     Int?
  idleTimeMin           Int?

  // ── Deslocamento ─────────────────────────────────────
  distanceKm              Float?
  geofenceBreaches        Int     @default(0)
  routeDeviationMaxMeters Int?

  // ── Scores (0-100) ────────────────────────────────────
  scoreExecution    Int?
  scoreReliability  Int?
  scoreRisk         Int?

  // ── Fraude ────────────────────────────────────────────
  fraudFlags Json?  // array de { type, severity, detail }

  calculatedAt DateTime @default(now())
  source       String   @default("BATCH") // REALTIME | BATCH

  @@index([tenantId, ownerEmail])
  @@index([executionId])
}

// Registro granular de consentimento por técnico
model ConsentRecord {
  id         String   @id @default(cuid())
  tenantId   String?
  ownerEmail String
  policyId   String?
  policy     CollectionPolicy? @relation(fields: [policyId], references: [id])
  docId      String?
  doc        ComplianceDoc? @relation(fields: [docId], references: [id])

  consentType String  // LOCATION_BACKGROUND | LOCATION_FOREGROUND |
                      // DEVICE_TELEMETRY | DATA_RETENTION | FULL
  accepted    Boolean
  ipAddress   String?
  deviceId    String?
  appVersion  String?

  acceptedAt DateTime @default(now())
  revokedAt  DateTime?

  @@unique([ownerEmail, policyId, consentType])
  @@index([ownerEmail])
  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────
// AVALIAÇÕES / MINHA PRODUTIVIDADE (técnico + satisfação cliente)
// ─────────────────────────────────────────────────────────

enum EvaluationTemplateType {
  CLIENT
  AUDIT
  INTERNAL
}

enum EvaluationQuestionType {
  RATING
  NPS
  BOOLEAN
  TEXT
  MULTIPLE_CHOICE
}

enum EvaluationInstanceStatus {
  PENDING
  RESPONDED
  IN_REVIEW
  FINALIZED
}

enum EvaluationClassification {
  EXCELLENT
  GOOD
  CRITICAL
}

enum EvaluationDisputeStatus {
  PENDING
  MAINTAIN_EVAL
  ADJUSTED
  INVALIDATED
}

enum EvaluationActionPlanStatus {
  OPEN
  IN_PROGRESS
  DONE
}

model EvaluationTemplate {
  id           String                 @id @default(cuid())
  tenantId     String
  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  type         EvaluationTemplateType
  active       Boolean                @default(true)
  triggerRules Json?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  questions EvaluationTemplateQuestion[]
  instances EvaluationInstance[]

  @@index([tenantId, active])
}

model EvaluationTemplateQuestion {
  id         String               @id @default(cuid())
  templateId String
  template   EvaluationTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  text       String
  type       EvaluationQuestionType
  weight     Float                @default(1)
  required   Boolean              @default(true)
  options    Json?
  categoryKey String?
  sortOrder  Int                  @default(0)

  responses EvaluationResponse[]

  @@index([templateId])
}

model EvaluationInstance {
  id               String                   @id @default(cuid())
  tenantId         String
  tenant           Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  templateId       String
  template         EvaluationTemplate       @relation(fields: [templateId], references: [id], onDelete: Restrict)
  targetType       String
  executionId      String?
  execution        ChecklistExecution?      @relation(fields: [executionId], references: [id], onDelete: SetNull)
  technicianUserId String
  technician       User                     @relation("EvaluationInstanceTechnician", fields: [technicianUserId], references: [id], onDelete: Cascade)
  status           EvaluationInstanceStatus @default(PENDING)
  triggeredBy      String?
  scheduledFor     DateTime?
  idempotencyKey   String?                  @unique
  displayText      String?                  @db.Text
  rawClientText    String?                  @db.Text
  /// Token opaco para o cliente abrir o formulário público (sem login).
  publicToken      String?                  @unique
  publicTokenExpiresAt DateTime?
  moderationMeta   Json?
  insights         Json?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  responses        EvaluationResponse[]
  score            EvaluationScore?
  acknowledgements EvaluationAcknowledgement[]
  internalNotes    EvaluationInternalNote[]
  actionPlans      EvaluationActionPlan[]
  disputes         EvaluationDispute[]

  @@index([tenantId, technicianUserId, createdAt])
  @@index([executionId])
}

model EvaluationResponse {
  id         String                   @id @default(cuid())
  instanceId String
  instance   EvaluationInstance       @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  questionId String
  question   EvaluationTemplateQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  value      Json

  @@unique([instanceId, questionId])
  @@index([instanceId])
}

model EvaluationScore {
  id               String                   @id @default(cuid())
  instanceId       String                   @unique
  instance         EvaluationInstance       @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  totalScore       Float
  scoreByCategory  Json
  classification   EvaluationClassification
}

model EvaluationAcknowledgement {
  id         String             @id @default(cuid())
  instanceId String
  instance   EvaluationInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime           @default(now())

  @@unique([instanceId, userId])
}

model EvaluationInternalNote {
  id         String             @id @default(cuid())
  instanceId String
  instance   EvaluationInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  body       String             @db.Text
  createdAt  DateTime           @default(now())

  @@index([instanceId])
}

model EvaluationActionPlan {
  id               String                     @id @default(cuid())
  tenantId         String
  tenant           Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instanceId       String
  instance         EvaluationInstance         @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  technicianUserId String
  technician       User                       @relation("ActionPlanTechnician", fields: [technicianUserId], references: [id], onDelete: Cascade)
  description      String                     @db.Text
  status           EvaluationActionPlanStatus @default(OPEN)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@index([instanceId])
  @@index([tenantId])
}

model EvaluationDispute {
  id                 String                  @id @default(cuid())
  tenantId           String
  tenant             Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instanceId         String
  instance           EvaluationInstance      @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  technicianUserId   String
  technician         User                    @relation("DisputeOpenedByTechnician", fields: [technicianUserId], references: [id], onDelete: Cascade)
  justification      String                  @db.Text
  status             EvaluationDisputeStatus @default(PENDING)
  supervisorId       String?
  supervisor         User?                   @relation("DisputeResolvedBySupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  resolutionNote     String?                 @db.Text
  adjustedTotalScore Float?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([tenantId, status])
  @@index([instanceId])
}
