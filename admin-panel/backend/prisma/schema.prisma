// BrSpark Admin — Prisma Schema (PostgreSQL)
// Run: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────
// ADMINS (painel interno)
// ─────────────────────────────────────────────────────────
model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String   // bcrypt hash
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  auditLogs AuditLog[]
}

// ─────────────────────────────────────────────────────────
// PLANOS
// ─────────────────────────────────────────────────────────
model Plan {
  id            String   @id @default(cuid())
  name          String   @unique  // Basic | Pro | Enterprise
  priceMonthly  Decimal  @db.Decimal(10,2)
  priceYearly   Decimal  @db.Decimal(10,2)
  maxAssets     Int      // -1 = unlimited
  maxUsers      Int      // -1 = unlimited (usuários do painel no geral)
  /// Cota de técnicos de campo (papéis USER e PROVIDER ativos). -1 = ilimitado.
  maxTechnicians Int     @default(5)
  storageGb     Int
  features      Json     // { stock, vault, ai, facialVisionProvider: COMPREFACE|AUTO|AWS, ... }
  /// Requisições de IA por mês (fuso período: calendário UTC ou ver uso futuro). -1 = ilimitado.
  quotaAiFacialPerMonth           Int @default(-1)
  quotaAiVisionDetectionPerMonth  Int @default(-1)
  quotaAiVisionAnalysisPerMonth   Int @default(-1)
  /// Limite mensal de OS de campo (FT) e de tarefas de rotina (RT) criadas/concluídas — -1 = ilimitado.
  quotaFieldTasksMonthly          Int @default(-1)
  quotaRoutineTasksMonthly        Int @default(-1)
  /// Pedidos proxy «Google Maps Routes» (ETA trecho) por mês, por tenant. -1 = ilimitado; 0 = desativado.
  quotaGoogleMapsRoutesPerMonth   Int @default(-1)
  /// Modelos no Form Builder (ChecklistTemplate). -1 = ilimitado.
  maxChecklistTemplates           Int @default(-1)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  subscriptions Subscription[]
}

// ─────────────────────────────────────────────────────────
// TENANTS
// ─────────────────────────────────────────────────────────
model Tenant {
  id           String   @id @default(cuid())
  name         String                        // nome completo do usuário
  slug         String   @unique              // gerado do email
  email        String   @unique              // email do dono da conta (= login)
  ownerName    String                        // nome de exibição
  phone        String?
  taxId        String?                       // CPF
  avatarUrl    String?
  defaultLang  String   @default("pt-BR")
  localeId     String?
  locale       LocaleProfile? @relation(fields: [localeId], references: [id])
  status       TenantStatus @default(TRIAL)
  sectorCode   String?                       // telecom | utilities | saude | predial | outro
  /// Extensões por tenant (ex.: trackChatModeration). Fusão com env no backend.
  features     Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscription         Subscription?
  users                User[]
  assets               Asset[]
  locations            Location[]
  auditLogs            AuditLog[]
  featureFlags         FeatureFlag[]
  translationOverrides TranslationOverride[]
  collectionPolicies   CollectionPolicy[]
  complianceDocs       ComplianceDoc[]       @relation("TenantComplianceDocs")
  materialsReceiptInputs MaterialsReceiptInput[]
  technicianRevenueInputs TechnicianRevenueInput[]
  evaluationTemplates   EvaluationTemplate[]
  evaluationInstances   EvaluationInstance[]
  evaluationActionPlans EvaluationActionPlan[]
  evaluationDisputes    EvaluationDispute[]
  technicianRegistrationApplications TechnicianRegistrationApplication[]
  providerAffiliations  ProviderTenantAffiliation[]
  workTimeSettings      WorkTimeSettings?
  workTimePunches       WorkTimePunch[]
  routineTaskAssignments RoutineTaskAssignment[]
  planUsagePeriods      TenantPlanUsagePeriod[]
  checklistTemplates     ChecklistTemplate[]
  referenceLibraries     ReferenceLibrary[]
}

/// Biblioteca de referência por tenant (catálogo para integrações e pré-carga de dados).
model ReferenceLibrary {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  maxImageEdgePx Int      @default(768)
  imageQuality   Int      @default(80)
  revision       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  fields ReferenceLibraryField[]
  rows   ReferenceLibraryRow[]

  @@index([tenantId])
}

model ReferenceLibraryField {
  id        String   @id @default(cuid())
  libraryId String
  library   ReferenceLibrary @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  key       String
  label     String?
  type      String   @default("text")
  sortOrder Int      @default(0)

  @@unique([libraryId, key])
  @@index([libraryId])
}

model ReferenceLibraryRow {
  id          String   @id @default(cuid())
  libraryId   String
  library     ReferenceLibrary @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  externalKey String
  payload     Json     @default("{}")
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([libraryId, externalKey])
  @@index([libraryId, updatedAt])
}

/// Política de registro de horas trabalhadas (ponto) — 1 registro por tenant.
model WorkTimeSettings {
  id          String   @id @default(cuid())
  tenantId    String   @unique
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  moduleEnabled                 Boolean @default(false)
  requireFaceOnEveryPunch       Boolean @default(true)
  requireGpsOnEveryPunch        Boolean @default(true)
  requireResolvedAddress        Boolean @default(true)
  maxClockDriftSeconds          Int     @default(300)
  minGpsAccuracyMeters          Int?
  employeeNoticeMarkdown        String? @db.Text
  consentVersion                String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum WorkTimePunchType {
  CLOCK_IN
  CLOCK_OUT
  BREAK_START
  BREAK_END
}

enum WorkTimePunchSyncStatus {
  PENDING
  SYNCED
  ERROR
}

/// Brasil: rótulos do app móvel (CLT = fluxo «ponto»; PJ = «Registro» / «Horas registradas hoje»). Só aplicável quando o tenant tem `LocaleProfile.countryCode = BR`.
enum WorkTimeBrazilRegime {
  CLT
  PJ
}

model WorkTimePunch {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type              WorkTimePunchType
  deviceTimestamp   DateTime
  serverTimestamp   DateTime            @default(now())
  lat               Float?
  lng               Float?
  accuracy          Float?
  formattedAddress  String?             @db.Text
  addressResolvedAt DateTime?

  faceVerificationId String?
  faceScore          Float?
  faceEngine         String?
  /// true quando, no momento da batida, a matrícula facial não cumpria fotos base + FaceMatch sincronizado.
  faceEnrollmentInvalid Boolean @default(false)

  /// Batida registada fora do percurso ideal (falha de GPS, endereço, face, etc.) com justificativa.
  exceptionRegistration   Boolean @default(false)
  exceptionJustification  String? @db.Text
  /// Resumo da validação: dispositivo, GPS, endereço, face (auditoria).
  validationSnapshot      Json?

  syncStatus WorkTimePunchSyncStatus @default(SYNCED)
  rawPayload Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, userId, deviceTimestamp])
  @@index([userId, createdAt])
}

/// Candidatura de cadastro de prestador (formulário global + revisão do gestor).
model TechnicianRegistrationApplication {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Token secreto na URL de convite (único).
  inviteToken    String   @unique
  invitedEmail   String
  status         String   @default("INVITED")
  /// Última mensagem do gestor ao pedir ajustes (visível ao candidato).
  revisionNote   String?
  /// Payload alinhado ao formulário admin (dados pessoais, endereço, docs, horários, regiões, fotos base…).
  responsesJson  Json     @default("{}")
  /// Senha definida pelo candidato na submissão (bcrypt); removida após aprovação.
  passwordHash   String?
  /// Utilizador criado após aprovação (1:1).
  createdUserId  String?  @unique
  createdUser    User?    @relation("TechRegCreatedUser", fields: [createdUserId], references: [id], onDelete: SetNull)
  /// Quem criou o convite (painel).
  createdByUserId String?
  /// Utilizador da app que iniciou sessão para preencher (mesmo e-mail do convite).
  candidateUserId String?
  candidateUser   User?    @relation("TechRegCandidateUser", fields: [candidateUserId], references: [id], onDelete: SetNull)
  submittedAt    DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  events         TechnicianRegistrationEvent[]

  @@index([tenantId, status])
  @@index([invitedEmail, tenantId])
}

model TechnicianRegistrationEvent {
  id              String   @id @default(cuid())
  applicationId   String
  application     TechnicianRegistrationApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type            String
  message         String?
  actorEmail      String?
  createdAt       DateTime @default(now())

  @@index([applicationId, createdAt])
}

/// Identidade global do prestador (independente de tenant).
model ProviderIdentity {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  globalStatus  String   @default("PENDING") // PENDING, VERIFIED, REJECTED, SUSPENDED
  kycStatus     String   @default("PENDING") // PENDING, APPROVED, REJECTED, PROCESSING, FAILED
  kycReviewedAt DateTime?
  kycReviewNote String?
  kycProvider   String?  @map("kyc_provider")
  kycExternalId String?  @map("kyc_external_id")
  score         Float    @default(5.0)
  cft           String?
  specialty     String?
  skillsJson    Json?
  profileJson   Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  affiliations  ProviderTenantAffiliation[]
  applications  ProviderOnboardingApplication[]
}

/// Vínculo do prestador global com cada tenant (convite/parceria/operação).
model ProviderTenantAffiliation {
  id                     String   @id @default(cuid())
  tenantId               String
  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  providerIdentityId     String
  providerIdentity       ProviderIdentity @relation(fields: [providerIdentityId], references: [id], onDelete: Cascade)
  status                 String   @default("INVITED") // INVITED, REQUESTED, ACTIVE, INACTIVE, SUSPENDED, REJECTED
  invitationToken        String?  @unique
  invitedByUserId        String?
  requestedAt            DateTime?
  invitedAt              DateTime?
  activatedAt            DateTime?
  suspendedAt            DateTime?
  note                   String?
  tenantScheduleJson     Json?
  tenantServiceLocationIds Json?
  tenantDocsJson         Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([tenantId, providerIdentityId])
  @@index([tenantId, status])
  @@index([providerIdentityId, status])
}

/// Candidatura de onboarding/KYC global (sem tenant obrigatório).
model ProviderOnboardingApplication {
  id                 String   @id @default(cuid())
  providerIdentityId String
  providerIdentity   ProviderIdentity @relation(fields: [providerIdentityId], references: [id], onDelete: Cascade)
  status             String   @default("DRAFT") // DRAFT, SUBMITTED, NEEDS_REVISION, APPROVED, REJECTED
  inviteToken        String?  @unique
  responsesJson      Json     @default("{}")
  revisionNote       String?
  submittedAt        DateTime?
  resolvedAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([providerIdentityId, status])
}

// ─────────────────────────────────────────────────────────
// SOBREPOSIÇÃO DE TRADUÇÃO (TENANT OVERRIDES)
// ─────────────────────────────────────────────────────────
model TranslationOverride {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  key       String   // i18n key como "common.save" ou "metatag.AssetStatus"
  language  String   // pt-BR, en-US, es-ES
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key, language])
}

// ─────────────────────────────────────────────────────────
// CONFIGURAÇÕES GLOBAIS / LOCALIZAÇÃO
// ─────────────────────────────────────────────────────────
model LocaleProfile {
  id              String   @id @default(cuid())
  countryCode     String   @unique // BR, US, ES, AR, CL...
  name            String   // Brasil, United States, España
  language        String   @default("pt-BR")
  currency        String   @default("BRL")
  currencySymbol  String   @default("R$")
  dateFormat      String   @default("DD/MM/YYYY")
  numberFormat    String   @default("PT_STYLE") // PT_STYLE (1.000,00) or US_STYLE (1,000.00)
  timezone        String   @default("UTC")
  taxIdLabel      String   @default("Tax ID") // CPF, SSN, NIF, RUT
  postalCodeLabel String   @default("Postal Code") // CEP, ZIP, CP
  measureSystem   String   @default("METRIC") // METRIC, IMPERIAL
  isActive        Boolean  @default(true)
  tenants         Tenant[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

// ─────────────────────────────────────────────────────────
// ASSINATURAS
// ─────────────────────────────────────────────────────────
model Subscription {
  id            String   @id @default(cuid())
  tenantId      String   @unique
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  planId        String
  plan          Plan     @relation(fields: [planId], references: [id])
  billingCycle  BillingCycle @default(MONTHLY)
  status        SubStatus    @default(ACTIVE)
  currentStart  DateTime
  currentEnd    DateTime
  cancelledAt   DateTime?
  trialEndsAt   DateTime?
  externalId    String?  // Stripe subscription ID
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  invoices      Invoice[]
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIALING
}

// ─────────────────────────────────────────────────────────
// FATURAS
// ─────────────────────────────────────────────────────────
model Invoice {
  id             String   @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  amount         Decimal  @db.Decimal(10,2)
  status         InvoiceStatus @default(PENDING)
  dueDate        DateTime
  paidAt         DateTime?
  externalId     String?  // Stripe invoice ID
  createdAt      DateTime @default(now())
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  VOID
}

/// Consumo mensal por tenant (faturação / quotas do plano). periodKey = AAAA-MM em America/Sao_Paulo.
model TenantPlanUsagePeriod {
  id                       String   @id @default(cuid())
  tenantId                 String
  tenant                   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  periodKey                String
  aiFacialCount            Int        @default(0)
  aiVisionDetectionCount   Int        @default(0)
  aiVisionAnalysisCount    Int        @default(0)
  fieldTasksCount          Int        @default(0)
  routineTasksCount        Int        @default(0)
  /// Chamadas ao proxy Google Maps Routes (computeRoutes) no período.
  googleMapsRouteCount     Int        @default(0)
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt

  @@unique([tenantId, periodKey])
  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────
// USUÁRIOS
// ─────────────────────────────────────────────────────────
model User {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  email      String
  /// Preenchido quando o utilizador confirma o e-mail (link enviado pelo painel).
  emailVerifiedAt              DateTime? @map("email_verified_at")
  /// Token opaco para verificação; expira em `emailVerificationExpiresAt`.
  emailVerificationToken       String?   @unique @map("email_verification_token")
  emailVerificationExpiresAt   DateTime? @map("email_verification_expires_at")
  name       String
  password   String   // bcrypt hash
  /// Matrícula funcional (RH / ponto). Uma por usuário; única por tenant quando preenchida.
  employeeMatricula String? @map("employee_matricula")
  avatarUrl  String?
  phone      String?
  /// Endereço residencial / correspondência (JSON estruturado, alinhado a multi-location)
  addressJson       Json?
  /// Documentos pessoais: [{ id, docType, label, identifier, validFrom, validTo, issuingBody, notes, locationIds[] }]
  personalDocuments Json?
  /// Fotos base para reconhecimento facial (admin): [{ id, url, mimeType?, createdAt }]
  faceEnrollmentPhotos Json?
  /// Último estado da galeria Recognition FaceMatch: { status, at, faces?, subject?, message?, previous? }
  comprefaceRecognitionSync Json?
  role       UserRole @default(USER)
  /// BCP-47 (ex.: pt-BR, en-US, es-ES) para tradução automática no chat; null = usar idioma do dispositivo / tenant.
  preferredChatLocale String? @map("preferred_chat_locale")
  isActive   Boolean  @default(true)
  lastLogin  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  auditLogs  AuditLog[]
  pushTokens PushToken[]
  technicianProfile TechnicianProfile?
  providerIdentity  ProviderIdentity?
  /// Preenchido se o usuário foi criado por uma candidatura de prestador aprovada.
  techRegistrationCreatedFrom TechnicianRegistrationApplication? @relation("TechRegCreatedUser")
  technicianRegistrationCandidacies TechnicianRegistrationApplication[] @relation("TechRegCandidateUser")
  currentSessionId String?
  currentDeviceId  String?
  materialsReceiptInputs MaterialsReceiptInput[] @relation("MaterialsReceiptConductor")
  technicianRevenueInputs TechnicianRevenueInput[] @relation("TechnicianRevenueConductor")
  evaluationInstancesAsTechnician EvaluationInstance[] @relation("EvaluationInstanceTechnician")
  evaluationAcknowledgements      EvaluationAcknowledgement[]
  evaluationInternalNotes         EvaluationInternalNote[]
  evaluationActionPlans           EvaluationActionPlan[] @relation("ActionPlanTechnician")
  disputesOpened                  EvaluationDispute[] @relation("DisputeOpenedByTechnician")
  disputesResolved                EvaluationDispute[] @relation("DisputeResolvedBySupervisor")
  workTimePunches                   WorkTimePunch[]
  routineTaskAssignments            RoutineTaskAssignment[]

  workTimeTrackingEnabled Boolean   @default(false)
  workTimeEnrolledAt      DateTime?
  /// Brasil (`tenant.locale.countryCode = BR`): regime de cópia no app. Fora do BR deve permanecer null.
  workTimeBrazilRegime    WorkTimeBrazilRegime? @map("work_time_brazil_regime")
  /// Notas visíveis só no painel admin (suporte / operações)
  adminInternalNotes String? @map("admin_internal_notes") @db.Text
  /// Termos de plataforma (Fase 4) — data e rótulo de versão
  termsAcceptedAt    DateTime? @map("terms_accepted_at")
  termsVersion       String?   @map("terms_version")
  /// OTP por telefone (Fase 1)
  phoneVerifiedAt    DateTime? @map("phone_verified_at")
  /// URL do contrato/termo assinado (ZapSign etc.)
  platformContractUrl String? @map("platform_contract_url")

  @@unique([email, tenantId])
  @@unique([tenantId, employeeMatricula])
}

/// Sessão de OTP (login / registo com telefone ou e-mail) — códigos são guardados com hash
model OtpLoginChallenge {
  id            String   @id @default(cuid())
  channel       String   // SMS | WHATSAPP | EMAIL
  target        String
  /// bcrypt hash do código
  codeHash      String
  attempts      Int      @default(0)
  maxAttempts   Int      @default(5)
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  consumedAt    DateTime?
  userId        String?
  /// Propósito: login | register | tech_identify
  purpose       String   @default("login")
  /// Metadados (deviceId, locale, ipHash)
  metadataJson  Json?

  @@index([target, purpose, createdAt])
  @@index([expiresAt])
}

model TechnicianProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String   @default("PENDING") // PENDING, ACTIVE, INACTIVE, SUSPENDED
  score     Float    @default(5.0)
  cft       String?  // Conselho Federal dos Técnicos
  specialty String?
  /// Horários: { mon: [{ id, enabled, start, end, locationIds[] }], ... } — vários turnos/dia; legado: mon: { enabled, start, end }
  workScheduleJson Json?
  /// Lista de competências / tags
  skillsJson       Json?
  /// IDs de Location (tenant) onde o prestador atende — multi-location
  serviceLocationIds Json?
  /// Cobertura geográfica operacional do prestador no app/painel.
  /// Formato atual: { homeBase: { latitude, longitude, address?, city?, state?, postalCode?, countryCode? }, radiusKm, notes? }
  serviceCoverageGeoJson Json?
  /// Documentos profissionais (certificações, ASO, etc.) com locationIds[] por linha
  professionalDocuments Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  USER
  PROVIDER
  MANAGER
  TENANT_ADMIN
  SAAS_ADMIN
}

// ─────────────────────────────────────────────────────────
// BENS / ATIVOS
// ─────────────────────────────────────────────────────────
model Asset {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  parentId    String?  // hierarchical tree
  title       String
  type        AssetType
  status      String   @default("Operacional")
  description String?
  imageUrl    String?
  locationId  String?
  location    Location? @relation(fields: [locationId], references: [id])
  metadata    Json?    // custom fields (details, photos, etc.)
  deletedAt   DateTime? // soft delete para sync mobile
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  children    Asset[]  @relation("AssetHierarchy")
  parent      Asset?   @relation("AssetHierarchy", fields: [parentId], references: [id])
  stockItems  StockItem[]
}

enum AssetType {
  REAL_ESTATE
  TERRESTRIAL // legado — migrar para MOBILITY / MACHINERY
  MOBILITY
  MACHINERY
  AQUATIC
  IT
  COLLECTIONS
  SPECIAL
  OTHER
}

// ─────────────────────────────────────────────────────────
// MULTI-LOCATION
// ─────────────────────────────────────────────────────────
model Location {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  name       String
  type       LocationType @default(BUILDING)
  address    String?
  floor      String?
  room       String?
  icon       String?
  latitude   Float?
  longitude  Float?
  parentId   String?
  parent     Location? @relation("LocationHierarchy", fields: [parentId], references: [id])
  children   Location[] @relation("LocationHierarchy")
  assets     Asset[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum LocationType {
  BUILDING
  FLOOR
  ROOM
  AREA
  WAREHOUSE
  OTHER
}

// ─────────────────────────────────────────────────────────
// ESTOQUE
// ─────────────────────────────────────────────────────────
model StockItem {
  id           String   @id @default(cuid())
  assetId      String
  asset        Asset    @relation(fields: [assetId], references: [id])
  name         String
  sku          String
  currentStock Int      @default(0)
  minStock     Int      @default(1)
  unit         String   @default("un")
  subLocation  String?
  unitPrice    Decimal? @db.Decimal(10,2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  movements    StockMovement[]

  @@unique([assetId, sku])
}

model StockMovement {
  id          String   @id @default(cuid())
  itemId      String
  item        StockItem @relation(fields: [itemId], references: [id])
  type        MovementType
  quantity    Int
  reason      String?
  fromAssetId String?
  toAssetId   String?
  createdAt   DateTime @default(now())
}

enum MovementType {
  IN
  OUT
  TRANSFER
}

// ─────────────────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────────────────
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  adminId    String?
  admin      Admin?   @relation(fields: [adminId], references: [id])
  action     String   // e.g. TENANT_CREATE, ASSET_UPDATE, LOGIN
  resource   String   // what was affected
  category   AuditCategory
  metadata   Json?    // extra context
  ipAddress  String?
  createdAt  DateTime @default(now())
}

enum AuditCategory {
  AUTH
  DATA
  ADMIN
  SYSTEM
}

// ─────────────────────────────────────────────────────────
// FEATURE FLAGS
// ─────────────────────────────────────────────────────────
model FeatureFlag {
