// ─────────────────────────────────────────────────────────
// INTEGRAÇÕES
// ─────────────────────────────────────────────────────────
model Integration {
  id                        String   @id @default(cuid())
  name                      String
  type                      IntType
  description               String?
  icon                      String?
  apiKey                    String?  // encrypted in production — FaceMatch: Recognition
  comprefaceDetectionKey    String?
  comprefaceVerificationKey String?
  baseUrl                   String?
  webhookUrl                String?
  status                    String   @default("ACTIVE")  // ACTIVE | ERROR | DISCONNECTED
  lastTestedAt              DateTime?
  metadata                  Json?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

// IntType.VISION: «Visão IA - YOLO» (legado: «Visão IA (checklists)») — POST multipart; «Visão IA - Moondream» — API cloud (VQA).
enum IntType {
  AI_LLM
  EMAIL
  PUSH
  STORAGE
  WEBHOOK
  ERP
  PAYMENT
  MAPS
  VISION
}

// ─────────────────────────────────────────────────────────
// COMPLIANCE / LGPD
// ─────────────────────────────────────────────────────────
model ComplianceDoc {
  id          String   @id @default(cuid())
  type        DocType
  version     String   // e.g. "1.2"
  locale      String   @default("pt-BR") // BCP-47 pt-BR | en-US | es-ES — ativo por type+tenant+locale
  title       String
  content     String   @db.Text
  isActive    Boolean  @default(false)  // only one active per type
  publishedAt DateTime?
  createdBy   String?  // admin email
  tenantId    String?  // null = global default
  tenant      Tenant?  @relation("TenantComplianceDocs", fields: [tenantId], references: [id])
  sectorCode  String?  // telecom | utilities | saude | predial | outro
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  acceptances ComplianceAcceptance[]
  consentRecords ConsentRecord[]
}

enum DocType {
  TERMS_OF_USE
  PRIVACY_POLICY
  LGPD_DPA
  COOKIE_POLICY
}

model ComplianceAcceptance {
  id        String   @id @default(cuid())
  docId     String
  doc       ComplianceDoc @relation(fields: [docId], references: [id])
  userId    String?
  tenantId  String?
  ipAddress String?
