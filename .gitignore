# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem
.com.greenworldsoft.syncfolderspro

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Backups de base de dados (dados sensíveis: credenciais, PII, etc.)
# Gerados localmente pelo painel/scripts — nunca versionar.
admin-panel/backend/backups/*.sql.gz
admin-panel/backend/backups/*.sql
admin-panel/backups/.last_auto_backup

# Uploads locais (JPEG/PNG/PDF, etc.) — não versionar; evita repo inchado e ficheiros tratados como texto
admin-panel/backend/public/uploads/**
!admin-panel/backend/public/uploads/.gitkeep
