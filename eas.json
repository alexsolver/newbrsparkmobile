      }
    },
    "preview-lan": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE": "http://192.168.15.73:3001"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://api.brspark.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
