{
  "cli": {
    "version": ">= 18.7.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_DEBUG_TECH_REG_SUBMIT": "1"
      },
      "android": {
        "gradleCommand": ":app:assembleDebug"
      },
      "ios": {
        "buildConfiguration": "Debug"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://api.brspark.com"
      }
    },
    "preview-lan": {
      "distribution": "internal",
      "channel": "preview-lan",
      "env": {
        "EXPO_PUBLIC_API_BASE": "http://192.168.15.73:3001"
      }
    },
    "production": {
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://api.brspark.com"
      },
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./credentials/google-play-service-account.json",
        "track": "production"
      },
      "ios": {
        "bundleIdentifier": "com.brspark",
        "ascAppId": "6763369142"
      }
    }
  }
}
