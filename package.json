{
  "name": "ariamobile",
  "version": "1.0.1",
  "main": "expo-router/entry",
  "scripts": {
    "postinstall": "node scripts/ensure-expo-sqlite-ios.js && patch-package",
    "ios:pod": "cd ios && pod install",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "android:dev": "expo run:android",
    "ios:dev": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "theme:export-css": "npx --yes tsx scripts/export-theme-css.ts",
    "test:sync-regression": "npx --yes tsx scripts/test-sync-policy-regression.mjs",
    "test:multitenancy-scope": "node scripts/test-multitenancy-scope-matrix.mjs",
    "test:authorization-regression": "node scripts/test-authorization-regression.mjs",
    "test:capability-gating-regression": "node scripts/test-capability-gating-regression.mjs",
    "test:tenant-branding": "node scripts/test-tenant-branding-regression.mjs",
    "test:provider-task-filter-regression": "npx --yes tsx scripts/test-provider-task-filter-regression.ts",
    "test:register-personal-client-helper": "node scripts/test-register-personal-client-helper.mjs",
    "test:multitenancy-regression-suite": "node scripts/test-multitenancy-regression-suite.mjs",
    "check:admin-inline-dom": "bash admin-panel/scripts/check-no-inline-dom-handlers.sh",
    "audit:deps": "npm audit --omit=dev --audit-level=critical",
    "i18n:check": "node scripts/i18n-validate.mjs",
    "i18n:scan-pt": "bash scripts/i18n-scan-pt-ui.sh",
    "i18n:sync-es": "node scripts/i18n-sync-es.mjs",
    "eas:build:android": "eas build --profile production --platform android",
    "eas:submit:android": "eas submit --profile production --platform android --latest",
    "eas:build:ios": "eas build --profile production --platform ios",
    "eas:build:all": "eas build --profile production --platform all",
    "eas:update:production": "eas update --channel production --auto",
    "eas:update:preview": "eas update --channel preview --auto",
    "eas:submit:ios:ci": "node scripts/eas-submit-ios-noninteractive.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@noble/ciphers": "^2.2.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/drawer": "^7.9.8",
    "ajv": "^8.18.0",
    "aria-automatic-time": "file:./modules/aria-automatic-time",
    "aria-location-integrity": "file:./modules/aria-location-integrity",
    "expo": "~54.0.0",
    "expo-apple-authentication": "~8.0.8",
    "expo-application": "~7.0.8",
    "expo-asset": "~12.0.12",
    "expo-audio": "~1.1.1",
    "expo-auth-session": "~7.0.10",
    "expo-av": "~16.0.8",
    "expo-battery": "~10.0.8",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.8",
    "expo-dev-client": "~6.0.20",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-keep-awake": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-live-activity": "^0.4.2",
    "expo-local-authentication": "~17.0.8",
    "expo-localization": "~17.0.8",
    "expo-location": "~19.0.8",
    "expo-network": "~8.0.8",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.23",
    "expo-screen-orientation": "~9.0.8",
    "expo-secure-store": "^55.0.13",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-updates": "~29.0.16",
    "expo-video": "~3.0.16",
    "expo-video-thumbnails": "~10.0.8",
    "expo-web-browser": "~15.0.10",
    "expr-eval": "^2.0.2",
    "i18next": "^25.10.3",
    "json5": "^2.2.3",
    "react": "19.1.0",
    "react-i18next": "^16.6.0",
    "react-native": "0.81.5",
    "react-native-calendars": "^1.1314.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "^1.27.2",
    "react-native-pager-view": "6.9.1",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~4.1.1",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.15.4",
    "react-native-worklets": "^0.8.1",
    "react-native-worklets-core": "^1.6.3"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.10",
    "eas-cli": "^18.7.0",
    "patch-package": "^8.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
